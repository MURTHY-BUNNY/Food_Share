# Copy this file to .env and replace the placeholders with local values.
# Never commit .env or put real credentials in this example.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=foodshare
DB_PASSWORD=replace-with-your-local-database-password
DB_NAME=foodshare

DONOR_TOKEN_SECRET=replace-with-a-long-random-secret
ADMIN_TOKEN_SECRET=replace-with-a-different-long-random-secret
ADMIN_USERNAME=admin
# Generate with: python backend/generate_admin_hash.py
ADMIN_PASSWORD_HASH=

# Comma-separated exact frontend origins for deployment, for example:
# CORS_ALLOWED_ORIGINS=https://foodshare.example.com
CORS_ALLOWED_ORIGINS=

# Optional. Leave blank for demo mode (OTP codes appear in the app).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=FoodShare
SMTP_SSL=false

# Optional Google Identity Services web client ID.
GOOGLE_CLIENT_ID=

# Optional comma-separated domains to reject during email signup.
DISPOSABLE_EMAIL_DOMAINS=
